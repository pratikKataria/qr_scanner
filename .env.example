# Copy this file to .env and fill in real values. Do NOT commit .env (add it to .gitignore).
# Example environment variables that were previously in ecosystem.config.js
NODE_ENV=production
PORT=6677
HOST=127.0.0.1
APP_NAMESPACE=com.example.app
# APP_FINGERPRINT contains sensitive data — replace with your actual fingerprint
APP_FINGERPRINT=<your-app-fingerprint-here>
BASE_URL=https://example.com
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
